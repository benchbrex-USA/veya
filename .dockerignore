# Build-context guards. The checkpoint safetensors files stay out of the
# context. The container fetches the verified release at boot.
.git
.github
node_modules
.wrangler
site
.env
.env.*
**/.env
models/production/**/*.safetensors
models/production/.cache
.mypy_cache
.pytest_cache
.ruff_cache
.venv
.coverage
__pycache__
*.pyc
*.egg-info
build/
dist/
# Only artifacts/release/ ships — keep historical experiment outputs (~500 MB)
# and older decision/scope journals out of the context.
artifacts/experiments/
artifacts/decisions/
artifacts/commercialization/
research/
experts/
quantum/
notebooks/
tests/
docs/
assets/
*.md
.dockerignore
Dockerfile
docker-compose.yml
k8s/
