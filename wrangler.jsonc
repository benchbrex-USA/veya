{
  // Cloudflare Workers config for the GitHub-connected build on account
  // 8d0a6a64de03f4c9b14184398e75aa6e (deploy command: `npx wrangler deploy`).
  //
  // The PyTorch decision model cannot run inside a Worker, so this Worker is a
  // thin edge reverse proxy: it forwards every request to the audited serving
  // stack (web/server.py gateway + web/model_server.py) reachable at
  // VEYA_ORIGIN, and gives the project a stable public hostname
  // (veya.<account-subdomain>.workers.dev) instead of an ephemeral tunnel URL.
  "name": "veya",
  "main": "worker/veya-edge.mjs",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Live gateway origin (cloudflared quick tunnel in front of 127.0.0.1:3000).
    // Update this var when the quick tunnel URL changes; the model service
    // itself stays bound to loopback and is never exposed directly.
    "VEYA_ORIGIN": "https://educated-entertainment-bookmarks-aging.trycloudflare.com"
  },
  "observability": {
    "enabled": true
  }
}
