{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Staging Worker `veya-staging`. Deploy only with
  // `--config wrangler.staging.jsonc`; the Workers Builds trigger for
  // deploy/cloudflare-staging must use that flag. See RUNBOOK.md.
  "name": "veya-staging",
  "account_id": "8d0a6a64de03f4c9b14184398e75aa6e",
  "main": "worker/veya-container.mjs",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/__*",
      "/healthz",
      "/readyz",
      "/startupz",
      "/version"
    ]
  },
  "containers": [
    {
      "name": "veya-runtime",
      "class_name": "VeyaContainer",
      "scheduling_policy": "default",
      "image": "./deploy/cloudflare/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1,
      "observability": {
        "enabled": true
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VEYA_CONTAINER",
        "class_name": "VeyaContainer"
      }
    ]
  },
  "exports": {
    "VeyaContainer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "veya-runtime"
    }
  },
  "r2_buckets": [
    {
      "binding": "VEYA_ARTIFACTS",
      "bucket_name": "veya-model-artifacts"
    }
  ],
  "ratelimits": [
    {
      "name": "VEYA_RATE_INFERENCE",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "VEYA_RATE_HEAVY",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "secrets": {
    "required": ["VEYA_EDGE_TOKEN", "VEYA_DEMO_TOKEN"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "VEYA_RELEASE_ID": "0.3.5-audit-baseline.1",
    "VEYA_CHECKPOINT_SHA256": "891102d372688fc2a094dac56a384bc537b87c63f21f9f3dac0be2b7cbc8d86c",
    "VEYA_MANIFEST_SHA256": "80720058c6b07dfef0640171d4193ff7bcaa3f40629ac60df7f9b28e074d65a4",
    "VEYA_SLEEP_AFTER": "15m"
  },
  "observability": {
    "enabled": true
  }
}
