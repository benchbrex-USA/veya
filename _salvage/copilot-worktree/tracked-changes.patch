-/* Cinematic system: the four points and two decision axes resolve into the supplied mark. */
-:root{--motion-quick:160ms;--motion-ui:260ms;--motion-reveal:620ms;--motion-cinema:1550ms}
-.hero{background:radial-gradient(ellipse 55% 65% at 77% 48%,#1512a3 0%,var(--blue) 72%);isolation:isolate}
-.hero:after{content:"";position:absolute;inset:0;opacity:.16;pointer-events:none;background:linear-gradient(90deg,transparent 49.94%,rgba(253,251,242,.36) 50%,transparent 50.06%),linear-gradient(0deg,transparent 49.94%,rgba(253,251,242,.3) 50%,transparent 50.06%);background-size:72px 72px;mask-image:linear-gradient(90deg,transparent 42%,black 100%)}
