-.hero-actions{animation:hero-rise 600ms var(--ease) 870ms both}
-.hero-art{z-index:2}
-.hero-orbit{animation:orbit-enter 1000ms var(--ease) both;border-color:rgba(253,251,242,.16)}
-.hero-orbit:before{inset:15%;border-color:rgba(253,251,242,.19)}
-.hero-orbit:after{inset:31%;border-color:rgba(253,251,242,.13)}
-.hero-orbit .canonical-mark{opacity:0;animation:mark-resolve 550ms var(--ease) 1030ms both;box-shadow:0 30px 90px rgba(0,0,0,.13)}
-.signal-geometry{position:absolute;z-index:2;width:33%;height:33%;animation:geometry-depart 340ms ease 1030ms both}
-.signal-point{position:absolute;width:6%;height:6%;background:var(--ivory);border-radius:50%;box-shadow:0 0 16px rgba(253,251,242,.36);animation:point-converge 700ms var(--ease) 220ms both}
-.point-nw{left:31%;top:31%;--from-x:-84px;--from-y:-62px}
-.point-ne{right:31%;top:31%;--from-x:92px;--from-y:-66px}
-.point-sw{left:31%;bottom:31%;--from-x:-80px;--from-y:75px}
-.point-se{right:31%;bottom:31%;--from-x:82px;--from-y:78px}
-.axis{position:absolute;background:var(--ivory);opacity:0;animation:axis-lock 480ms var(--ease) 620ms both}
-.axis-n,.axis-s{height:21%;width:5%;left:47.5%}
-.axis-n{top:4%}.axis-s{bottom:4%}
-.axis-e,.axis-w{width:22%;height:5%;top:47.5%}
-.axis-e{right:4%}.axis-w{left:4%}
-.trajectory{position:absolute;border:1px solid rgba(253,251,242,.16);border-radius:50%;opacity:0;animation:path-appear 1100ms ease 150ms both}
-.trajectory-a{inset:7% 29%;transform:rotate(49deg)}
-.trajectory-b{inset:28% 5%;transform:rotate(-28deg)}
-.trajectory-c{inset:23%;border-style:dashed;opacity:.14}
-.orbit-point{animation:orbit-point-appear 700ms ease 350ms both}
-.hero-art-caption{position:absolute;width:min(42vw,650px);bottom:13px;display:flex;justify-content:space-between;color:rgba(253,251,242,.56);font:10px/1 ui-monospace,monospace;letter-spacing:.14em}
