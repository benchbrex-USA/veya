-/* Architecture signal follows the audited branch, once, without scroll listeners. */
-.architecture-map{margin:65px 0 75px;padding:50px clamp(18px,4vw,64px);background:var(--night);color:var(--ivory);display:flex;align-items:center;gap:18px;min-height:330px;position:relative;overflow:hidden}
