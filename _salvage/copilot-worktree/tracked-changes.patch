-/* Editorial pacing: each stage is legible even before motion runs. */
-.section-head{align-items:start}.section-head h2{max-width:980px}.section-intro{margin-top:30px}
-.motion-reveal{transition:opacity var(--motion-reveal) var(--ease),transform var(--motion-reveal) var(--ease)}
-.motion-reveal:not(.is-visible){opacity:0;transform:translateY(22px)}
-.motion-reveal.is-visible{opacity:1;transform:translateY(0)}
-.model-step{position:relative;overflow:hidden;transition:background var(--motion-ui),color var(--motion-ui)}
-.model-step:before{content:"";position:absolute;top:0;left:0;width:100%;height:2px;background:var(--blue);transform:scaleX(0);transform-origin:left;transition:transform 460ms var(--ease)}
