-.field textarea:focus,.field input:focus,.field select:focus,.candidate-row input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(3,0,139,.08)}
-.text-button{transition:opacity var(--motion-quick),transform var(--motion-quick)}.text-button:hover{opacity:.65;transform:translateX(2px)}
-.tech-details summary{transition:color var(--motion-quick)}.tech-details summary:hover{color:#6562dc}
-.result-panel{position:relative;overflow:hidden}.result-panel:before{content:"";position:absolute;left:0;top:0;height:100%;width:1px;background:var(--blue);opacity:0;transition:opacity var(--motion-ui)}
