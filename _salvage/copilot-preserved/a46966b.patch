+    if len(candidate_schemas) != len(candidates):
+        raise ValueError("frozen Phase-10 candidates contain duplicate IDs")
+    for name, rows in partitions.items():
+        for row in rows:
+            if candidate_schemas.get(row["candidate_id"]) != row["schema"]:
+                raise ValueError(f"frozen Phase-10 {name} row has no matching candidate")
+
+    train_schemas = {row["schema"] for row in partitions["train"]}
+    development_schemas = {row["schema"] for row in partitions["development"]}
+    validation_schemas = {row["schema"] for row in partitions["schema_held_out_validation"]}
+    if train_schemas & (development_schemas | validation_schemas):
+        raise ValueError("frozen Phase-10 training schemas overlap held-out schemas")
+    if development_schemas & validation_schemas:
+        raise ValueError("frozen Phase-10 development and validation schemas overlap")
+
+    return (
+        partitions["train"],
+        partitions["development"],
+        partitions["schema_held_out_validation"],
+        candidates,
+    )
