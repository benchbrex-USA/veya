diff --git a/tests/test_phase10_data_freeze.py b/tests/test_phase10_data_freeze.py
new file mode 100644
index 0000000..115bb0d
--- /dev/null
+++ b/tests/test_phase10_data_freeze.py
@@ -0,0 +1,105 @@
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from research.veyabench import phase10_data
+from research.veyabench.run_phase10_train import load_inputs
+
+
+def _write_frozen_inputs(data_dir: Path, phase_dir: Path) -> None:
+    data_dir.mkdir()
+    phase_dir.mkdir()
+    partitions = {
+        "train": [{"id": "train:1", "candidate_id": "train:yes", "schema": "train", "text": "yes"}],
+        "development": [
+            {"id": "dev:1", "candidate_id": "dev:yes", "schema": "dev", "text": "yes"}
+        ],
+        "schema_held_out_validation": [
+            {
+                "id": "validation:1",
+                "candidate_id": "clinc150:yes",
+                "schema": "clinc150",
+                "text": "yes",
+            }
+        ],
+    }
+    for name, rows in partitions.items():
+        (data_dir / f"{name}.jsonl").write_text(
+            "".join(json.dumps(row, sort_keys=True) + "\n" for row in rows),
+            encoding="utf-8",
+        )
+    candidates = [
+        {"candidate_id": "train:yes", "schema": "train", "raw": "yes"},
+        {"candidate_id": "dev:yes", "schema": "dev", "raw": "yes"},
+        {"candidate_id": "clinc150:yes", "schema": "clinc150", "raw": "yes"},
+    ]
+    (data_dir / "candidates.json").write_text(json.dumps(candidates), encoding="utf-8")
+    (data_dir / "registry.json").write_text("{}", encoding="utf-8")
+
+    freeze = {
+        "format": "veya-phase10-split-freeze-v1",
+        "inputs_sha256": {
+            name: hashlib.sha256((data_dir / name).read_bytes()).hexdigest()
+            for name in (
+                "train.jsonl",
+                "development.jsonl",
+                "schema_held_out_validation.jsonl",
+                "candidates.json",
+                "registry.json",
+            )
+        },
+    }
+    for name, rows in partitions.items():
+        freeze[name] = {"examples": len(rows), "sha256": phase10_data.split_digest(rows)}
+    (phase_dir / "splits.json").write_text(json.dumps(freeze), encoding="utf-8")
+
+
+def test_training_loader_uses_unchanged_committed_frozen_inputs():
+    train, development, validation, candidates = load_inputs()
+
+    assert (len(train), len(development), len(validation), len(candidates)) == (
+        4635,
+        260,
+        3000,
+        280,
+    )
+    freeze = json.loads(Path(phase10_data.PHASE10, "splits.json").read_text())
+    assert phase10_data.split_digest(validation) == freeze["schema_held_out_validation"]["sha256"]
+
+
+def test_frozen_loader_rejects_modified_partition_without_rebuilding(tmp_path, monkeypatch):
+    data_dir = tmp_path / "data"
+    phase_dir = tmp_path / "phase10"
+    _write_frozen_inputs(data_dir, phase_dir)
+    monkeypatch.setattr(phase10_data, "DATA_OUT", str(data_dir))
+    monkeypatch.setattr(phase10_data, "PHASE10", str(phase_dir))
+    train_path = data_dir / "train.jsonl"
+    original = train_path.read_text(encoding="utf-8")
+
+    train_path.write_text(original.replace('"text": "yes"', '"text": "changed"'), encoding="utf-8")
+    with pytest.raises(ValueError, match="train.jsonl does not match splits.json"):
+        phase10_data.load_frozen_inputs()
+    assert "changed" in train_path.read_text(encoding="utf-8")
+
+
+def test_frozen_loader_rejects_schema_leakage(tmp_path, monkeypatch):
+    data_dir = tmp_path / "data"
+    phase_dir = tmp_path / "phase10"
+    _write_frozen_inputs(data_dir, phase_dir)
+    monkeypatch.setattr(phase10_data, "DATA_OUT", str(data_dir))
+    monkeypatch.setattr(phase10_data, "PHASE10", str(phase_dir))
+
+    train_path = data_dir / "train.jsonl"
+    train = json.loads(train_path.read_text(encoding="utf-8"))
+    train.update(candidate_id="clinc150:yes", schema="clinc150")
+    train_path.write_text(json.dumps(train), encoding="utf-8")
+    freeze_path = phase_dir / "splits.json"
+    freeze = json.loads(freeze_path.read_text(encoding="utf-8"))
+    freeze["inputs_sha256"]["train.jsonl"] = hashlib.sha256(train_path.read_bytes()).hexdigest()
+    freeze["train"]["sha256"] = phase10_data.split_digest([train])
+    freeze_path.write_text(json.dumps(freeze), encoding="utf-8")
+
+    with pytest.raises(ValueError, match="training schemas overlap held-out schemas"):
+        phase10_data.load_frozen_inputs()
