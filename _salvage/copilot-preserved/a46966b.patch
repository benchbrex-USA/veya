index 0000000..b4ab34b
--- /dev/null
+++ b/tests/test_phase10_metrics.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pytest
+
+from research.veyabench.run_phase10_train import paired_bootstrap, retrieval_metrics
+
+
+def test_retrieval_metrics_reports_correct_ranks_and_recall():
+    metrics, positions, order = retrieval_metrics(
+        np.asarray([[0.9, 0.1, 0.2], [0.1, 0.8, 0.05]]),
+        np.asarray([0, 0]),
+    )
+
+    assert positions.tolist() == [1, 2]
+    assert order.tolist() == [[0, 2, 1], [1, 0, 2]]
+    assert metrics["recall_at_1"] == 0.5
+    assert metrics["recall_at_4"] == 1.0
+    assert metrics["mrr"] == 0.75
+
+
+@pytest.mark.parametrize(
+    ("scores", "gold", "message"),
+    [
+        (np.asarray([0.1, 0.2]), np.asarray([0]), "two-dimensional"),
+        (np.empty((0, 2)), np.asarray([], dtype=int), "queries and candidates"),
+        (np.empty((1, 0)), np.asarray([0]), "queries and candidates"),
+        (np.asarray([[np.nan, 0.2]]), np.asarray([0]), "must be finite"),
+        (np.asarray([[0.1, 0.2]]), np.asarray([], dtype=int), "match the query count"),
+        (np.asarray([[0.1, 0.2]]), np.asarray([0.0]), "must be integers"),
+        (np.asarray([[0.1, 0.2]]), np.asarray([2]), "within the candidate matrix"),
+    ],
+)
+def test_retrieval_metrics_rejects_invalid_inputs(scores, gold, message):
+    with pytest.raises(ValueError, match=message):
+        retrieval_metrics(scores, gold)
+
+
+def test_paired_bootstrap_is_deterministic_for_binary_outcomes():
+    base = np.asarray([True, False, True, True])
+    candidate = np.asarray([True, True, True, False])
+
+    first = paired_bootstrap(base, candidate, draws=100)
+    second = paired_bootstrap(base, candidate, draws=100)
+
+    assert first == second
+    assert first["delta"] == 0.0
+    assert len(first["ci95"]) == 2
+
+
+@pytest.mark.parametrize(
+    ("base", "candidate", "draws", "message"),
+    [
+        (np.asarray([]), np.asarray([]), 10, "same non-zero length"),
+        (np.asarray([True]), np.asarray([True, False]), 10, "same non-zero length"),
+        (np.asarray([[True]]), np.asarray([[True]]), 10, "one-dimensional"),
+        (np.asarray([0.5]), np.asarray([True]), 10, "binary outcomes"),
+        (np.asarray([True]), np.asarray([True]), 0, "positive integer"),
+    ],
+)
+def test_paired_bootstrap_rejects_invalid_inputs(base, candidate, draws, message):
+    with pytest.raises(ValueError, match=message):
+        paired_bootstrap(base, candidate, draws=draws)
